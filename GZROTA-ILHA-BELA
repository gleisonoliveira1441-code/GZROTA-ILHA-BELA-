local function validarKey()
    local texto = keyBox.Text

    if not KEYS_VALIDAS[texto] then
        keyStatus.Text = "Key Incorreta!"
        keyStatus.TextColor3 = COR.vermelho
        keyBox.Text = ""
        return
    end

    if keyQueimada(texto) then
        keyStatus.Text = "Key Expirada Permanentemente!"
        keyStatus.TextColor3 = COR.vermelho
        return
    end

    local resta = tempoRestante(texto)

    if resta == nil then
        setTempoInicio(texto)
        resta = 86400
    elseif resta <= 0 then
        queimarKey(texto)
        keyStatus.Text = "Key Expirada (00:00)!"
        keyStatus.TextColor3 = COR.vermelho
        return
    end

    keyValida = true
    keyUsada = texto

    keyStatus.Text = "Key Aceita!"
    keyStatus.TextColor3 = COR.amarelo

    timerLbl.Visible = true
    if texto == MasterAcesso then
        timerLbl.Text = "Key Permanente (Infinito)"
    else
        task.spawn(function()
            while keyValida and keyGui and keyGui.Parent do
                task.wait(1)
                if not keyValida or not keyGui then break end
                local r = tempoRestante(keyUsada) or 0
                timerLbl.Text = "Expira em: " .. formatarTempo(r)
                if r <= 0 then
                    queimarKey(keyUsada)
                    keyValida = false
                    keyGui:Destroy()
                    keyGui = nil
                    notify("Expirado", "Sua key expirou!", 5)
                end
            end
        end)
    end

    task.wait(1)

    TweenService:Create(keyCard, TweenInfo.new(0.4), {Size = UDim2.new(0, 440, 0, 0)}):Play()
    local fundo = keyGui:FindFirstChildOfClass("Frame")
    if fundo then TweenService:Create(fundo, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play() end

    task.wait(0.5)
    if keyGui then keyGui:Destroy(); keyGui = nil end
    _G.AbrirRotaGUI()
end

