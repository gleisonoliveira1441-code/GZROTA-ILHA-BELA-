-- TRAVAR/DESTRAVAR RODAS
-- ============================================================
local constraintsOriginais = {}

local function salvarConstraint(c)
    if constraintsOriginais[c] then return end
    if c:IsA("HingeConstraint") then
        constraintsOriginais[c] = { tipo = "Hinge", AngularVelocity = c.AngularVelocity, MotorMaxTorque = c.MotorMaxTorque }
    elseif c:IsA("Motor6D") then
        constraintsOriginais[c] = { tipo = "Motor6D", MaxVelocity = c.MaxVelocity }
    elseif c:IsA("BodyAngularVelocity") then
        constraintsOriginais[c] = { tipo = "BodyAngular", AngularVelocity = c.AngularVelocity, MaxTorque = c.MaxTorque }
    end
end

local function restaurarConstraint(c)
    local orig = constraintsOriginais[c]
    if not orig then return end
    pcall(function()
        if orig.tipo == "Hinge" then
            c.AngularVelocity = orig.AngularVelocity
            c.MotorMaxTorque = orig.MotorMaxTorque
        elseif orig.tipo == "Motor6D" then
            c.MaxVelocity = orig.MaxVelocity
        elseif orig.tipo == "BodyAngular" then
            c.AngularVelocity = orig.AngularVelocity
            c.MaxTorque = orig.MaxTorque
        end
    end)
    constraintsOriginais[c] = nil
end

local function travarRodas(carro)
    if not carro then return end
    for _, c in ipairs(carro:GetDescendants()) do
        if c:IsA("HingeConstraint") then
            salvarConstraint(c); c.AngularVelocity = 0; c.MotorMaxTorque = 0
        elseif c:IsA("Motor6D") then
            salvarConstraint(c); c.MaxVelocity = 0
        elseif c:IsA("BodyAngularVelocity") then
            salvarConstraint(c); c.AngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end

local function destravarRodas()
    local carro = getVeiculo()
    if not carro then
        notify("Roda", "Você não está em um carro!", 2)
        return
    end
    for c, _ in pairs(constraintsOriginais) do
        if c and c.Parent then restaurarConstraint(c) end
    end
    constraintsOriginais = {}
    for _, p in ipairs(carro:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = false
            p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            p.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
    for _, c in ipairs(carro:GetDescendants()) do
        if c:IsA("HingeConstraint") then
            pcall(function()
                if c.MotorMaxTorque == 0 then c.MotorMaxTorque = math.huge end
                if c.AngularVelocity == 0 then c.AngularVelocity = 100 end
            end)
        end
    end
    notify("Roda", "Rodas destravadas!", 3)
end

