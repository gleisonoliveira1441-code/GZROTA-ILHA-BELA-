local function teleportarComCarro(rota)
    local pos = rota.pos
    local yawCustom = rota.yaw

    local char, hrp, hum = getChar()
    if not char or not hrp then return end

    local yReal = acharChao(pos.X, pos.Z, pos.Y)
    local posFinal = Vector3.new(pos.X, yReal, pos.Z)

    local carro, seat = getVeiculo()
    if not carro or not seat then
        hrp.CFrame = CFrame.new(posFinal + Vector3.new(0, 3, 0))
        return
    end
    local carroPart = carro.PrimaryPart
    if not carroPart then
        for _, p in ipairs(carro:GetDescendants()) do
            if p:IsA("BasePart") then carroPart = p break end
        end
    end
    if not carroPart then return end

    local estados = {}
    for _, p in ipairs(carro:GetDescendants()) do
        if p:IsA("BasePart") then
            estados[p] = { Anchored = p.Anchored, CanCollide = p.CanCollide }
            p.Anchored = true
            p.CanCollide = false
            p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            p.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
    for _, p in ipairs(carro:GetDescendants()) do
        if p:IsA("BodyVelocity") or p:IsA("BodyGyro") then p:Destroy() end
    end

    local rotReta
    if yawCustom then
        rotReta = CFrame.Angles(0, math.rad(yawCustom), 0)
    else
        local rotAtual = carroPart.CFrame - carroPart.CFrame.Position
        local _, yaw, _ = rotAtual:ToEulerAnglesYXZ()
        rotReta = CFrame.Angles(0, yaw, 0)
    end

    local destinoCF = CFrame.new(posFinal) * rotReta
    carro:PivotTo(destinoCF)
    task.wait(0.15)
    carro:PivotTo(destinoCF)
    task.wait(0.15)

    if hum and seat and seat.Parent then
        hrp.CFrame = seat.CFrame * CFrame.new(0, 2, 0)
        task.wait(0.05)
        pcall(function() seat:Sit(hum) end)
    end

    task.wait(0.2)
    carro:PivotTo(destinoCF)
    task.wait(0.1)

    for p, est in pairs(estados) do
        if p and p.Parent then
            p.Anchored = est.Anchored
            p.CanCollide = est.CanCollide
        end
    end
    task.wait(0.1)
    travarRodas(carro)
end

