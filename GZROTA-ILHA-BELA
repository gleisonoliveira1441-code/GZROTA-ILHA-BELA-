-- ═══ ANIMAÇÕES CONTÍNUAS (pulse + shimmer) ═══
RunService.Heartbeat:Connect(function()
    if not gui.Parent then return end
    local t = tick()

    -- pulso no glow externo
    local pulse = (math.sin(t * 2) + 1) * 0.5
    glow.BackgroundTransparency = 0.9 - pulse * 0.15
    stroke.Transparency         = 0.15 + (1 - pulse) * 0.25

    -- shimmer no título
    titleGrad.Offset = Vector2.new(((t * 0.35) % 2) - 1, 0)

    -- pulso no ícone
    local iconPulse = 1 + math.sin(t * 3) * 0.04
    iconBg.Size = UDim2.new(0, 32 * iconPulse, 0, 32 * iconPulse)
    iconBg.Position = UDim2.new(0, 14 - (32 * (iconPulse - 1)) / 2, 0.5, -16 - (32 * (iconPulse - 1)) / 2)

    -- pulso no dot verde
    local dp = (math.sin(t * 4) + 1) * 0.5
    dotGlow.BackgroundTransparency = 0.9 - dp * 0.3
    dotGlow.Size = UDim2.new(0, 14 + dp * 6, 0, 14 + dp * 6)
    dotGlow.Position = UDim2.new(0, -3 - (dp * 3), 0.5, -7 - (dp * 3))
end)

-- ═══ ARRASTAR ═══
local function makeDraggable(handle, target)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local d = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
end
