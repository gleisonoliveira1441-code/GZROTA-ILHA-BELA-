local ARQUIVO_SAVE = "GZRotas_Keys_Timer.json"

local function temFileAPI()
    return writefile and readfile and isfile
end

local function carregarTempos()
    if not temFileAPI() then return {} end
    if not isfile(ARQUIVO_SAVE) then return {} end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(ARQUIVO_SAVE))
    end)
    if ok and type(data) == "table" then return data end
    return {}
end

local function salvarTempos(tempos)
    if not temFileAPI() then return end
    pcall(function()
        writefile(ARQUIVO_SAVE, HttpService:JSONEncode(tempos))
    end)
end

local tempos = carregarTempos()

local function meiaNoiteHoje()
    local agora = os.time()
    local agoraLocal = agora + HORA_OFFSET * 3600
    local t = os.date("*t", agoraLocal)
    t.hour = 0; t.min = 0; t.sec = 0
    return os.time(t) - HORA_OFFSET * 3600
end

local function tempoRestante(key)
    if key == MasterAcesso then return 999999 end
    local inicio = tempos[key]
    if not inicio then return nil end
    if inicio == -1 then return -1 end
    if inicio < meiaNoiteHoje() then return 0 end
    return (meiaNoiteHoje() + 86400) - os.time()
end

local function keyQueimada(key) 
    if key == MasterAcesso then return false end
    return tempos[key] == -1 
end

local function queimarKey(key)
    if key == MasterAcesso then return end
    tempos[key] = -1
    salvarTempos(tempos)
end

local function setTempoInicio(key)
    if key == MasterAcesso then return end
    tempos[key] = os.time()
    salvarTempos(tempos)
end

local function formatarTempo(segundos)
    if not segundos or segundos < 0 then return "00:00:00" end
    local h = math.floor(segundos / 3600)
    local m = math.floor((segundos % 3600) / 60)
    local s = math.floor(segundos % 60)
    return string.format("%02d:%02d:%02d", h, m, s)
end

