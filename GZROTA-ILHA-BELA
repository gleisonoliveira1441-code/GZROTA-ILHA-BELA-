local function notify(t, txt, d)
    pcall(function()
        StarterGui:SetCore("SendNotification", {Title=t, Text=txt, Duration=d or 3})
    end)
end

local function getChar()
    local c = LP.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function getVeiculo()
    local char = LP.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local seat = hum.SeatPart
    if seat and seat:IsA("VehicleSeat") then
        local model = seat:FindFirstAncestorOfClass("Model")
        return model, seat
    end
    return nil, nil
end

local function acharChao(x, z, yRef)
    yRef = yRef or 0
    local origem1 = Vector3.new(x, yRef + 2, z)
    local destino1 = Vector3.new(x, yRef - 60, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LP.Character}
    local result = workspace:Raycast(origem1, destino1 - origem1, params)
    if result then return result.Position.Y end
    return yRef
end

